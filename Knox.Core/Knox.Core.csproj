<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Targets netstandard2.0 so the SAME shared logic is consumable by BOTH UI apps:
           - the .NET Framework 4.7.2 WPF app (Knox) can ONLY reference netstandard2.0
           - the modern .NET MAUI app (Knox.App) consumes netstandard2.0 fine too
         Kept single-target (not multi-targeted) on purpose: the non-SDK WPF project
         + a multi-targeted Core thrash the shared obj/project.assets.json during
         parallel solution builds. MSAL/net10-only code lives in Knox.App instead. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Knox</RootNamespace>
    <AssemblyName>Knox.Core</AssemblyName>
    <ProjectGuid>{A1B2C3D4-0000-4000-A000-000000000001}</ProjectGuid>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.2.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>

</Project>
