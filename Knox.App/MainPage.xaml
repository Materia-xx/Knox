<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Knox.App.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25"
            VerticalOptions="Center">
            <Image
                Source="dotnet_bot.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="Knox sample app logo" />

            <Label
                Text="Knox.App (Windows + Android)"
                Style="{StaticResource Headline}"
                HorizontalOptions="Center"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Sample app sharing logic from Knox.Core. Tap below to load settings through the shared library and confirm cross-platform code sharing works."
                Style="{StaticResource SubHeadline}"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                SemanticProperties.HeadingLevel="Level2" />

            <Button
                x:Name="CoreBtn"
                Text="Load settings via Knox.Core"
                SemanticProperties.Hint="Exercises the shared Knox.Core library"
                Clicked="OnCheckCoreClicked"
                HorizontalOptions="Fill" />

            <Label
                x:Name="CoreStatusLabel"
                Text=""
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

            <Button
                x:Name="CounterBtn"
                Text="Tap to confirm it's working"
                SemanticProperties.Hint="Counts the number of times you tap"
                Clicked="OnCounterClicked"
                HorizontalOptions="Fill" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
