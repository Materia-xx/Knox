<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Knox.App.Views.ConnectionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Knox.App.ViewModels"
    xmlns:models="clr-namespace:Knox.App.Logic.Models;assembly=Knox.App.Logic"
    x:DataType="vm:ConnectionsViewModel"
    Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add" Command="{Binding AddCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="12">
        <Label
            Grid.Row="0"
            Text="No connections yet. Tap 'Add' to register your Entra client/tenant."
            IsVisible="{Binding HasNoConnections}"
            Margin="4,8" />

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Connections}"
            SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:KnoxConnection">
                    <Border Margin="0,4" Padding="12" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                            <Label Grid.Row="1" Grid.Column="0" Text="{Binding TenantId}" FontSize="12" TextColor="Gray" />
                            <HorizontalStackLayout Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Spacing="4">
                                <Button
                                    Text="Edit"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ConnectionsViewModel}}, Path=EditCommand}"
                                    CommandParameter="{Binding .}" />
                                <Button
                                    Text="Delete"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ConnectionsViewModel}}, Path=DeleteCommand}"
                                    CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
