<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Knox.App.Views.LockPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Knox.App.ViewModels"
    x:DataType="vm:LockViewModel"
    Title="{Binding Title}"
    NavigationPage.HasNavigationBar="False">

    <Grid>
        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="16" Padding="24">
            <Label Text="Knox is locked" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="{Binding Status}" HorizontalOptions="Center" TextColor="Gray" />
            <Button Text="Unlock" Command="{Binding UnlockCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
