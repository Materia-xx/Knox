<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    SAFE WINDOWS TEST PUBLISH PROFILE

    AI ASSISTANTS: This is the publish profile to use whenever publishing is
    needed for development, testing, or validation. Never use a production
    profile unless the owner explicitly requests a production deployment.

    Output stays under the repository's ignored bin directory and never writes
    to the live OneDrive installation.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifierOverride>win-x64</RuntimeIdentifierOverride>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <WindowsPackageType>None</WindowsPackageType>
    <PublishDir>$(MSBuildProjectDirectory)\bin\Publish\Test\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
  </PropertyGroup>
</Project>
