<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Knox.App.Views.SecretPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Knox.App.ViewModels"
    x:DataType="vm:SecretViewModel"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <Label
                Text="{Binding SecretNameCaption}"
                FontSize="14"
                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                IsVisible="{Binding ShowSecretNameCaption}" />

            <Label Text="{Binding NameLabel}" />
            <Entry Text="{Binding EditableName}" Placeholder="{Binding NamePlaceholder}" />

            <Label Text="Value" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                <Entry
                    Grid.Column="0"
                    Text="{Binding Value}"
                    IsPassword="{Binding IsValueVisible, Converter={StaticResource InverseBool}}" />
                <Button Grid.Column="1" Text="{Binding ShowHideText}" Command="{Binding ToggleValueCommand}" />
                <Button Grid.Column="2" Text="Copy" Command="{Binding CopyValueCommand}" />
            </Grid>

            <Label Text="Folder (use / or \ to nest)" />
            <Entry Text="{Binding Folder}" Placeholder="e.g. prod/web" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <Label Grid.Column="0" Text="Tags" FontAttributes="Bold" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Add tag" Command="{Binding AddTagCommand}" />
            </Grid>

            <CollectionView ItemsSource="{Binding Tags}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TagRow">
                        <Grid ColumnDefinitions="*,*,Auto,Auto,Auto" ColumnSpacing="6" Margin="0,3">
                            <Entry Grid.Column="0" Text="{Binding Name}" Placeholder="name" />
                            <Entry Grid.Column="1" Text="{Binding Value}" Placeholder="value" />
                            <Button
                                Grid.Column="2"
                                Text="&#x1F517;"
                                FontSize="14"
                                Padding="0"
                                WidthRequest="36"
                                HeightRequest="36"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                IsVisible="{Binding IsHttpLink}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SecretViewModel}}, Path=OpenLinkCommand}"
                                CommandParameter="{Binding .}" />
                            <Button
                                Grid.Column="3"
                                Text="&#x1F4CB;"
                                FontSize="14"
                                Padding="0"
                                WidthRequest="36"
                                HeightRequest="36"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SecretViewModel}}, Path=CopyTagCommand}"
                                CommandParameter="{Binding .}" />
                            <Button
                                Grid.Column="4"
                                Text="&#x2715;"
                                FontSize="14"
                                Padding="0"
                                WidthRequest="36"
                                HeightRequest="36"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SecretViewModel}}, Path=RemoveTagCommand}"
                                CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="{Binding Status}" FontSize="12" TextColor="Gray" />

            <HorizontalStackLayout Spacing="8" HorizontalOptions="End" Margin="0,8">
                <Button Text="Delete" Command="{Binding DeleteCommand}" IsVisible="{Binding IsExisting}" />
                <Button Text="Save" Command="{Binding SaveCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
